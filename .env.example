# Copy to .env for local (non-Docker) development. docker-compose.yml
# does NOT read this file — its services get their env vars from the
# x-api-env/x-inventory-env anchors directly, with sensible local
# defaults baked in. This file is for running api/inventory/workers
# directly on your host, and for `alembic` commands run outside Docker.

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database (both services; each service's own Settings.database_url
# can point at a different value if you split them onto separate
# instances) ---
DATABASE_URL=postgresql+asyncpg://eventsphere:eventsphere_pw@localhost:5432/eventsphere

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# PLAINTEXT works against the local docker-compose broker. A managed
# broker that requires auth (e.g. Aiven's free Kafka tier) needs:
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=<from the Aiven console>
# KAFKA_SASL_PASSWORD=<from the Aiven console>
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# --- Inventory gRPC target, as seen by the API service ---
INVENTORY_GRPC_TARGET=localhost:50051
GRPC_PORT=50051

# --- Auth (API service only) ---
# Generate a real value with: openssl rand -hex 32
JWT_SECRET_KEY=changeme-generate-a-long-random-secret-and-set-this-via-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Rate limiting (API service only) ---
RATE_LIMIT_PER_MINUTE=60

# --- Reservations (Inventory service only) ---
RESERVATION_TTL_SECONDS=600
REAPER_INTERVAL_SECONDS=30
LOCK_TTL_MS=5000

# --- Used only by `alembic` commands run outside Docker; if unset,
# migrations/env.py falls back to DATABASE_URL above ---
# ALEMBIC_DATABASE_URL=postgresql+asyncpg://eventsphere:eventsphere_pw@localhost:5432/eventsphere
